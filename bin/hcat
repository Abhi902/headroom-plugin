#!/usr/bin/env bash
# hcat — compress-at-the-source for the headroom-usage-indicator plugin.
#
# Prints a compressed rendering of a structured file (JSON/logs/CSV/...) so the
# raw bytes never enter Claude's context. The original file on disk is the
# source of truth: for exact details, Read the path in the header with an
# offset/limit. Appends a "hcat" compression event to headroom's shared session
# stats file so the statusline and headroom_stats count the savings.
#
# Exit codes: 0 ok · 2 usage/missing file · 3 headroom python not found
#             4 compression failed
#
# Python resolution lives in scripts/lib/engine-resolve.sh (one definition for
# every entry point): $HCAT_PYTHON → sibling python of `headroom` on PATH → its
# shebang interpreter (skipped for MZ/PE launchers) → uv tool dir → ~/.headroom-venv
# (bin/ or Scripts/ layout). A flat legacy copy without the lib falls back to an
# inline resolver that is deliberately NARROWER than that lib — HCAT_PYTHON →
# PATH sibling of `headroom` → ~/.headroom-venv, with no uv-tool or shebang tier.

set -u

# Ambient-health state shared with the statusline badge: a fresh last-error file
# flips the badge to "broken" so silent engine failures stop looking like idle.
# The one shell definition lives in scripts/lib/headroom-state.sh (legacy flat
# installs keep a sibling copy); a partial copy degrades to a no-op recorder.
_hb="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo .)"
# shellcheck disable=SC1090,SC1091
# "$_hb/lib/..." is in the list because a flat ~/.claude install puts hcat at
# ~/.claude/hcat while /doctor --fix provisions the libs into ~/.claude/lib/ —
# the same lib/-first shape hcat-gate.sh and session-probe.sh already use.
for _sl in "$_hb/../scripts/lib/headroom-state.sh" "$_hb/lib/headroom-state.sh" "$_hb/headroom-state.sh"; do
  [ -f "$_sl" ] && { . "$_sl"; break; }
done
# shellcheck disable=SC1090,SC1091
for _er in "$_hb/../scripts/lib/engine-resolve.sh" "$_hb/lib/engine-resolve.sh" "$_hb/engine-resolve.sh"; do
  [ -f "$_er" ] && { . "$_er"; break; }
done
type note_error >/dev/null 2>&1 || note_error() { :; }
type resolve_engine_python >/dev/null 2>&1 || resolve_engine_python() {  # partial legacy copy
  # Deliberately NARROWER than scripts/lib/engine-resolve.sh: no uv tool dir and
  # no shebang-interpreter tier. Keep the PATH-sibling lookup though — a flat
  # install that lands here is exactly the pipx/uv population that needs it.
  local c d
  if [ -n "${HCAT_PYTHON:-}" ]; then printf '%s\n' "$HCAT_PYTHON"; return 0; fi
  if d=$(command -v headroom 2>/dev/null) && [ -n "$d" ]; then
    d=$(dirname "$d")
    for c in "$d/python" "$d/python.exe"; do
      [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
    done
  fi
  for c in "${HOME:-}/.headroom-venv/bin/python" "${HOME:-}/.headroom-venv/Scripts/python.exe"; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

if [ $# -ne 1 ] || [ -z "${1:-}" ]; then
  echo "usage: hcat <file>" >&2
  exit 2
fi
FILE=$1
if [ ! -f "$FILE" ] || [ ! -r "$FILE" ]; then
  echo "hcat: cannot read file: $FILE" >&2
  exit 2
fi

# Same rule as the gate and the doctor: the first IMPORTABLE candidate, not the
# first executable one. A decoy `python` beside the headroom console script would
# otherwise be chosen here and fail at import time with exit 4, while /doctor on
# the same machine reported a healthy engine.
PY=""; PY_BROKEN=""
if type resolve_engine_python_validated >/dev/null 2>&1; then
  # Dispatch on the status, do NOT collapse it with `||`. Status 2 means an
  # interpreter resolved but cannot import headroom -- a real outage. Folding it
  # into the empty/`not found` case made hcat print "headroom python not found",
  # exit 3 and light no badge, where every earlier version exited 4 and recorded
  # the breakage. hcat-gate.sh dispatches the same way; these two must agree.
  PY=$(resolve_engine_python_validated); case $? in
    0) ;;
    2) PY_BROKEN=$PY; PY="" ;;
    *) PY="" ;;
  esac
else
  PY=$(resolve_engine_python) || PY=""   # partial legacy copy: narrower lookup
fi
if [ -z "$PY" ] || [ ! -x "$PY" ]; then
  # No engine: TOON-lite lossless tier (pure jq) before giving up. A uniform
  # JSON array (same flat keys per row) renders as one header row + CSV-like
  # rows — typically 30-60% smaller, lossless, zero dependencies beyond jq —
  # so a fresh install without the Python engine still delivers savings.
  if command -v jq >/dev/null 2>&1; then
    toon=$(jq -r '
      def scal: (type=="object" or type=="array") | not;
      # Quote a string cell when it carries CSV specials OR would read back as
      # a JSON scalar bare ("1", "true", "null") — losslessness means string
      # 1 and number 1 must stay distinguishable. Keys go through cell too:
      # a comma-bearing key must not misalign the header.
      def jsonish: try (fromjson | true) catch false;
      def cell: if type=="string" then (if test("[,\"\n]") or jsonish then @json else . end) else @json end;
      if type=="array" and length>1 and all(.[]; type=="object" and (to_entries | all(.value|scal)))
      then (.[0]|keys_unsorted) as $k
        | if all(.[]; keys_unsorted == $k)
          then ($k|map(cell)|join(",")), (.[] | [.[$k[]]] | map(cell) | join(","))
          else empty end
      else empty end' "$FILE" 2>/dev/null) || toon=""
    if [ -n "$toon" ]; then
      raw_b=$(wc -c < "$FILE" | tr -d ' ')
      out_b=$(printf '%s\n' "$toon" | wc -c | tr -d ' ')
      if [ "$out_b" -lt $(( raw_b * 95 / 100 )) ] 2>/dev/null; then
        lines=$(wc -l < "$FILE" | tr -d ' ')
        kb=$(LC_ALL=C awk -v b="$raw_b" 'BEGIN{printf "%.1f", b/1024}')
        tb=$(( raw_b / 4 )); [ "$tb" -gt 0 ] || tb=1   # ~4 bytes/token estimate
        ta=$(( out_b / 4 )); [ "$ta" -gt 0 ] || ta=1
        pct=$(LC_ALL=C awk -v b="$tb" -v a="$ta" 'BEGIN{printf "%.1f", (1-a/b)*100}')
        abs_file=$(cd "$(dirname "$FILE")" 2>/dev/null && pwd)/$(basename "$FILE")
        printf '── hcat: %s · %s lines · %s KB · ~%s tok → ~%s tok (%s%% saved · toon-lite lossless, engine absent) · original on disk — Read that path (offset/limit) for exact details\n' \
          "$abs_file" "$lines" "$kb" "$tb" "$ta" "$pct"
        printf '%s\n' "$toon"
        exit 0
      fi
    fi
  fi
  # A never-installed engine is the ordinary idle state, NOT a breakage. A
  # resolved-but-broken one IS: say which interpreter, record it, and keep the
  # base's exit 4 so callers can still tell the two apart.
  if [ -n "$PY_BROKEN" ]; then
    echo "hcat: engine python found but cannot import headroom.compress ($PY_BROKEN) — run /doctor" >&2
    note_error engine "hcat: engine import failed ($PY_BROKEN) — run /doctor"
    exit 4
  fi
  echo "hcat: headroom python not found (pip install \"headroom-ai[all]\", or set HCAT_PYTHON)" >&2
  # PY is non-empty here exactly when HCAT_PYTHON points at a non-executable.
  [ -n "$PY" ] && note_error engine "hcat: HCAT_PYTHON is not executable ($PY) — run /doctor"
  exit 3
fi

PYTHONIOENCODING=utf-8 PYTHONUTF8=1 HF_HUB_OFFLINE=1 HEADROOM_UPDATE_CHECK=off exec "$PY" - "$FILE" <<'PYEOF'
import atexit, json, os, signal, sys, time

# POSIX advisory locking for the shared stats file. Windows has no fcntl, and
# this import used to sit inside _append_event's one broad try/except — so on
# Windows EVERY hcat run silently failed to record its savings. Guard it on its
# own (same best-effort style as _note_error) and append without the lock there.
try:
    import fcntl
except Exception:
    fcntl = None

# Mirrors the shell wrapper's STATE_DIR: a fresh last-error file flips the
# statusline badge to "broken"; a successful compression clears engine errors.
_STATE_DIR = os.environ.get("HEADROOM_STATE_DIR") or os.path.join(
    os.environ.get("HOME") or os.environ.get("TMPDIR") or "/tmp",
    ".claude", "headroom-indicator")
_LAST_ERROR = os.path.join(_STATE_DIR, "last-error")

def _note_error(component, message):
    try:
        os.makedirs(_STATE_DIR, exist_ok=True)
        msg = " ".join(str(message).split())[:200]
        with open(_LAST_ERROR, "w") as f:
            f.write(f"{int(time.time())} {component} {msg}\n")
    except Exception:
        pass

def _clear_error():
    # Only engine-class errors: a working compression proves the engine, not jq
    # or install wiring, so other components stay until the doctor clears them.
    try:
        with open(_LAST_ERROR) as f:
            parts = f.readline().split(None, 2)
        if len(parts) >= 2 and parts[1] in ("engine", "runtime"):
            os.remove(_LAST_ERROR)
    except Exception:
        pass

# `hcat big.json | head -1` must die silently when the reader closes the pipe,
# like cat does — otherwise python's stdout teardown spews BrokenPipeError on
# stderr. POSIX gets that from SIG_DFL below: the process dies by signal and
# nothing unwinds. Windows has NO SIGPIPE at all, so that guard is a no-op there
# and the interpreter raises instead — a traceback on every `hcat ... | head`,
# which the old comment predicted and left standing. Handle both.
def _exit_quietly_on_broken_pipe():
    # canonical CPython pattern: point stdout at devnull so interpreter shutdown
    # cannot re-raise while flushing, then exit 0 the way cat does
    try:
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    except Exception:
        pass
    os._exit(0)

_prev_excepthook = sys.excepthook

def _hcat_excepthook(exc_type, exc, tb):
    if issubclass(exc_type, BrokenPipeError):
        _exit_quietly_on_broken_pipe()
    _prev_excepthook(exc_type, exc, tb)

sys.excepthook = _hcat_excepthook

@atexit.register
def _hcat_hush_shutdown():
    # the other half: when the pipe closes with buffered output still pending,
    # the raise happens during shutdown rather than in a print()
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        _exit_quietly_on_broken_pipe()
    except Exception:
        pass

# HCAT_NO_SIGPIPE=1 skips the POSIX registration so the WINDOWS path can be
# reproduced, and regression-tested, on a POSIX host — the only difference
# between the two platforms here is this one call. Same spirit as DOCTOR_OS.
if hasattr(signal, "SIGPIPE") and not os.environ.get("HCAT_NO_SIGPIPE"):
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)

path = os.path.abspath(sys.argv[1])
try:
    with open(path, encoding="utf-8", errors="replace") as f:
        raw = f.read()
except OSError as e:
    print(f"hcat: cannot read file: {e}", file=sys.stderr)
    sys.exit(2)

lines = raw.count("\n") + (0 if raw.endswith("\n") or not raw else 1)
kb = len(raw.encode("utf-8", "replace")) / 1024

try:
    from headroom.compress import compress
    result = compress([{"role": "tool", "content": raw}])
except Exception as e:
    print(f"hcat: compression failed: {e}", file=sys.stderr)
    _note_error("runtime", f"hcat: compression failed: {e} — run /doctor")
    sys.exit(4)
_clear_error()

out = result.messages[0].get("content", raw)
if not isinstance(out, str):
    out = json.dumps(out)

before, after = result.tokens_before, result.tokens_after
saved_pct = round((1 - after / before) * 100, 1) if before else 0.0

def _append_event(tok_before, tok_after, pct, strategy):
    # Report savings into headroom's shared session stats (best effort, never fatal).
    try:
        from headroom import paths as _paths
        stats_dir = _paths.workspace_dir()
        stats_file = _paths.session_stats_path()
        stats_dir.mkdir(parents=True, exist_ok=True)
        event = {
            "type": "compress",
            "input_tokens": tok_before,
            "output_tokens": tok_after,
            "savings_percent": pct,
            "strategy": strategy,
            "timestamp": time.time(),
            "pid": os.getpid(),
        }
        line = json.dumps(event, separators=(",", ":")) + "\n"
        with open(stats_file, "a") as f:
            if fcntl is not None:
                fcntl.flock(f, fcntl.LOCK_EX)
                f.write(line)
                fcntl.flock(f, fcntl.LOCK_UN)
            else:
                # no flock (Windows): a single small "a"-mode write is the best
                # atomicity available, and losing the event is worse than a race
                f.write(line)
    except Exception:
        pass

def _toon_lite(text):
    # Lossless structural reformat for a uniform JSON array of flat objects:
    # one header row + CSV-like rows. Returns None when the shape doesn't fit.
    try:
        data = json.loads(text)
    except Exception:
        return None
    if not isinstance(data, list) or len(data) < 2:
        return None
    if not all(isinstance(r, dict) for r in data):
        return None
    keys = list(data[0].keys())
    for r in data:
        if list(r.keys()) != keys:
            return None
        for v in r.values():
            if isinstance(v, (dict, list)):
                return None
    def scalar_like(s):
        # A bare cell that PARSES as JSON ("1", "true", "null") would lose its
        # string-ness on the way back — quote it to keep the rendering lossless.
        try:
            json.loads(s)
            return True
        except Exception:
            return False
    def cell(v):
        if isinstance(v, str) and not any(c in v for c in ',"\n') and not scalar_like(v):
            return v
        return json.dumps(v, ensure_ascii=False)
    # Keys go through cell too: a comma-bearing key must not misalign the header.
    rows = [",".join(cell(k) for k in keys)]
    rows += [",".join(cell(r[k]) for k in keys) for r in data]
    return "\n".join(rows) + "\n"

# When semantic compression buys <5%, try the TOON-lite lossless tier before
# passing through raw — the dead zone stops being a savings dead zone.
if before == 0 or saved_pct < 5:
    t = _toon_lite(raw)
    if t is not None:
        tb = max(1, len(raw.encode("utf-8", "replace")) // 4)
        ta = max(1, len(t.encode("utf-8", "replace")) // 4)
        if ta <= tb * 0.95:
            pct = round((1 - ta / tb) * 100, 1)
            print(f"── hcat: {path} · {lines} lines · {kb:.1f} KB · "
                  f"~{tb} tok → ~{ta} tok ({pct}% saved · toon-lite lossless) · "
                  f"original on disk — Read that path (offset/limit) for exact details")
            print(t, end="" if t.endswith("\n") else "\n")
            _append_event(tb, ta, pct, "toon-lite")
            sys.exit(0)
    print(f"── hcat: {path} · {lines} lines · {kb:.1f} KB · passthrough "
          f"(compression would save {saved_pct}%)")
    print(raw, end="" if raw.endswith("\n") else "\n")
    sys.exit(0)

print(f"── hcat: {path} · {lines} lines · {kb:.1f} KB · "
      f"~{before} tok → ~{after} tok ({saved_pct}% saved) · "
      f"original on disk — Read that path (offset/limit) for exact details")
print(out, end="" if out.endswith("\n") else "\n")

_append_event(before, after, saved_pct, "hcat")
PYEOF
